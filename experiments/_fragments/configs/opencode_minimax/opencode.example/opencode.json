{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "enabled_providers": ["minimax"],
  "model": "minimax/replace_with_minimax_model_id",
  "small_model": "minimax/replace_with_minimax_small_model_id",
  "permission": "allow",
  "provider": {
    "minimax": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "MiniMax",
      "options": {
        "baseURL": "replace_with_minimax_base_url",
        "apiKey": "replace_with_minimax_api_key"
      },
      "models": {
        "replace_with_minimax_model_id": {
          "name": "replace_with_minimax_model_id"
        },
        "replace_with_minimax_small_model_id": {
          "name": "replace_with_minimax_small_model_id"
        }
      }
    }
  }
}
